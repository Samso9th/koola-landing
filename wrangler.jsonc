{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koola-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "API_ORIGIN": "https://api.koola.store" }
}
